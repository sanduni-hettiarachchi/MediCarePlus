rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getRole() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists() ? userDoc.data.role : null;
    }
    
    function isPatient() {
      return isAuthenticated() && (getRole() == 'patient' || getRole() == null);
    }
    
    function isCaregiver() {
      return isAuthenticated() && getRole() == 'caregiver';
    }
    
    function isNurse() {
      return isAuthenticated() && getRole() == 'nurse';
    }
    
    function isDoctor() {
      return isAuthenticated() && getRole() == 'doctor';
    }
    
    function isPharmacist() {
      return isAuthenticated() && getRole() == 'pharmacist';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isActiveCareLink(patientId, memberId) {
      let linkPath = /databases/$(database)/documents/care_links/$(patientId + '_' + memberId);
      return exists(linkPath) && get(linkPath).data.status == 'Active';
    }
    
    function hasPerm(patientId, memberId, perm) {
      let linkPath = /databases/$(database)/documents/care_links/$(patientId + '_' + memberId);
      return exists(linkPath) && 
             get(linkPath).data.status == 'Active' &&
             get(linkPath).data.permissions[perm] == true;
    }
    
    function hasValidAccessCode(patientId) {
      let codePath = /databases/$(database)/documents/access_codes/$(patientId);
      return exists(codePath) && 
             get(codePath).data.status == 'Active' &&
             get(codePath).data.expiresAt > request.time;
    }

    // users collection
    match /users/{userId} {
      allow get: if isAuthenticated() && (
        isOwner(userId) ||
        isActiveCareLink(userId, request.auth.uid)
      );
      allow list: if isAuthenticated() && resource.data.role in ['nurse', 'caregiver', 'doctor'];
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // medicines collection
    match /medicines/{medicineId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isActiveCareLink(resource.data.patientId, request.auth.uid) ||
        hasPerm(resource.data.patientId, request.auth.uid, 'viewSchedule') ||
        hasValidAccessCode(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        hasPerm(request.resource.data.patientId, request.auth.uid, 'editSchedule')
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasPerm(resource.data.patientId, request.auth.uid, 'editSchedule')
      );
      allow delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasPerm(resource.data.patientId, request.auth.uid, 'editSchedule')
      );
    }
    
    // reminder_times collection
    match /reminder_times/{reminderId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isActiveCareLink(resource.data.patientId, request.auth.uid) ||
        hasPerm(resource.data.patientId, request.auth.uid, 'viewSchedule') ||
        hasValidAccessCode(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        hasPerm(request.resource.data.patientId, request.auth.uid, 'editSchedule')
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasPerm(resource.data.patientId, request.auth.uid, 'editSchedule')
      );
      allow delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasPerm(resource.data.patientId, request.auth.uid, 'editSchedule')
      );
    }
    
    // dose_logs collection
    match /dose_logs/{logId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isActiveCareLink(resource.data.patientId, request.auth.uid) ||
        hasPerm(resource.data.patientId, request.auth.uid, 'viewSchedule') ||
        hasPerm(resource.data.patientId, request.auth.uid, 'viewAdherence') ||
        hasValidAccessCode(resource.data.patientId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        hasPerm(request.resource.data.patientId, request.auth.uid, 'editSchedule')
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasPerm(resource.data.patientId, request.auth.uid, 'editSchedule')
      );
      allow delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasPerm(resource.data.patientId, request.auth.uid, 'editSchedule')
      );
    }
    
    // care_links collection
    match /care_links/{linkId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isOwner(resource.data.memberId) ||
        (isCaregiver() && request.auth.uid == resource.data.memberId) ||
        (isNurse() && request.auth.uid == resource.data.memberId)
      );
      allow create: if request.auth != null &&
        request.resource.data.patientId == request.auth.uid &&
        request.resource.data.role in ['caregiver', 'nurse', 'doctor', 'pharmacist'] &&
        request.resource.data.status == 'Pending';
      allow update: if isAuthenticated() && (
        // Patient can update their own links fully
        isOwner(resource.data.patientId) ||
        // Member can only update status/respondedAt to Active/Declined
        (request.auth.uid == resource.data.memberId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
         request.resource.data.status in ['Active', 'Declined'])
      );
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        request.auth.uid == resource.data.memberId
      );
    }
    
    // care_notes collection
    match /care_notes/{noteId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isOwner(resource.data.authorId) ||
        isActiveCareLink(resource.data.patientId, request.auth.uid) ||
        isDoctor() || isNurse()
      );
      allow create: if isAuthenticated() && (
        isOwner(resource.data.authorId) || isNurse() || isDoctor()
      );
      allow update: if isAuthenticated() && isOwner(resource.data.authorId);
      allow delete: if isAuthenticated() && isOwner(resource.data.authorId);
    }
    
    // alerts collection
    match /alerts/{alertId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isActiveCareLink(resource.data.patientId, request.auth.uid) ||
        hasPerm(resource.data.patientId, request.auth.uid, 'viewAdherence')
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.patientId);
      allow delete: if isAuthenticated() && isOwner(resource.data.patientId);
    }
    
    // refill_requests collection
    match /refill_requests/{requestId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isPharmacist() ||
        isActiveCareLink(resource.data.patientId, request.auth.uid)
      );
      allow create: if isAuthenticated() && (
        isOwner(resource.data.patientId) || isPharmacist()
      );
      allow update: if isAuthenticated() && (
        isOwner(resource.data.patientId) || isPharmacist()
      );
    }
    
    // access_codes collection (for doctor/pharmacist QR access)
    match /access_codes/{codeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.patientId == request.auth.uid || isPatient());
      allow update: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isPatient());
      allow delete: if isAuthenticated() && (resource.data.patientId == request.auth.uid || isPatient());
    }
    
    // grants collection
    match /grants/{grantId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // notifications collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // refill_summary collection
    match /refill_summary/{summaryId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isActiveCareLink(resource.data.patientId, request.auth.uid) ||
        hasPerm(resource.data.patientId, request.auth.uid, 'viewSchedule')
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        hasPerm(request.resource.data.patientId, request.auth.uid, 'editSchedule')
      );
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasPerm(resource.data.patientId, request.auth.uid, 'editSchedule')
      );
      allow delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        hasPerm(resource.data.patientId, request.auth.uid, 'editSchedule')
      );
    }
    
    // prescriptions collection
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.patientId) ||
        isOwner(resource.data.addedBy) ||
        isActiveCareLink(resource.data.patientId, request.auth.uid) ||
        isDoctor() || isNurse()
      );
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.patientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }
  }
}